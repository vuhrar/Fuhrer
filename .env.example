# Example environment variables

# OpenAI
OPENAI_API_KEY=
# Anthropic
ANTHROPIC_API_KEY=
# Hugging Face (Inference API)
HF_API_KEY=

# الإعداد الافتراضي لاختيار النموذج (واحد من الأسماء في ai_engine.preset_names())
PRESET_NAME=Führer Law Brain (Qwen 0.6B) 🧠

# إعدادات مخصصة
CUSTOM_URL=
CUSTOM_MODEL=
CUSTOM_FMT=openai

# سلوك هجيني: إذا true سيحاول استخدام موديل محلي أولاً (إذا كان لديك endpoint محلي)
LOCAL_FIRST=false
LOCAL_ENDPOINT=http://localhost:1234

# إعدادات الخادم
HOST=0.0.0.0
PORT=8000
