{
  "name": "FüLaw Legal Workspace",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "server.py"]
    },
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start-background.sh",
  "postAttachCommand": "bash .devcontainer/start-background.sh",
  "remoteEnv": {
    "FUHRER_DATA_DIR": "/workspaces/.fulaw-data",
    "FULAW_PRIVATE_MODE": "true"
  },
  "portsAttributes": {
    "8000": {
      "label": "FüLaw private app",
      "onAutoForward": "openPreview",
      "visibility": "private"
    }
  },
  "forwardPorts": [8000]
}
